mod funny;

import std.player.sendMessage;

dict FunnyNess {
   var level: Number,
   val message: String
}

impl FunnyNess {
    fn setLevel(var this, val level: Number) {
        this.level = level;
    }

    fn getLevel(val this): Number {
        return this.level;
    }

    fn createSilly(val level: Number): FunnyNess {
        return FunnyNess {
            level: level,
            message: "Really Silly"
        };
    }

    fn new(): FunnyNess {
        return FunnyNess {
            level: 0,
            message: "Really Funny"
        };
    }
}

@OnPlayerSelection
fn sendFunny(val funny: FunnyNess) {
    val x = funny.getLevel();

    sendMessage("Level:");
    sendMessage(funny.level);
    sendMessage("Message:");
    sendMessage(funny.message);
}
