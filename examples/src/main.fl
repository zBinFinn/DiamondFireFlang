mod main;

import std.player.sendMessage;
import std.player.selection.defaultPlayer;

import funny.sendFunny;
import funny.FunnyNess;

@PlayerEvent("Join")
fn join() {
    val test = true;
    val test2 = false;
    with defaultPlayer() {
        sendMessage("Test 1");
    }
    if (test && test2) {
        with defaultPlayer() {
            sendMessage("test && test2");
        }
    }
    with defaultPlayer() {
            sendMessage("Test 2");
    }
    if (test || test2) {
        with defaultPlayer() {
            sendMessage("test || test2");
        }
    }
    with defaultPlayer() {
            sendMessage("Test 3");
    }
    if (true) {
        with defaultPlayer() {
            sendMessage("true");
        }
    }

    val x = 5;
    with defaultPlayer() {
        sendMessage("hi");
        val hi = 6;
        sendMessage("hi");
        val funny = FunnyNess {
            level: 5,
            message: "Hello"
        };
        sendFunny(funny);
        test();
    }
}

dict FunnierFunnyNess {
   funnyNess: FunnyNess
}

@OnPlayerSelection
fn test() {
   val funnier = FunnierFunnyNess {
      funnyNess: FunnyNess {
         level: 5,
         message: "Hello World"
      }
   };

   sendFunny(funnier.funnyNess);
}