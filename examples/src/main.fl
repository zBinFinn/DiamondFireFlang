mod main;

import std.player.sendMessage;
import std.player.selection.defaultPlayer;
import std.events.PlayerJoinEvent;

import funny.sendFunny;
import funny.FunnyNess;

fn balls(): Number {
    if (1 == 1) {
        return 5;
    }
    return 3;
}

@Event(PlayerJoinEvent)
fn join(var event: PlayerJoinEvent) {
    event.setCancelled(true);

    Player.showActionBar(s"Hello World");

    val test = true;
    val test2 = false;
    with defaultPlayer() {
        sendMessage("Test 1");
    }
    if (test && test2) {
        with defaultPlayer() {
            sendMessage("test && test2");
        }
    }
    with defaultPlayer() {
            sendMessage("Test 2");
    }
    if (test || test2) {
        with defaultPlayer() {
            sendMessage("test || test2");
        }
    }
    with defaultPlayer() {
            sendMessage("Test 3");
    }
    if (true) {
        with defaultPlayer() {
            sendMessage("true");
        }
    }

    val x = 5;
    with defaultPlayer() {
        sendMessage("hi");
        val hi = 6;
        sendMessage("hi");
        val funny = FunnyNess {
            level: 5,
            message: "Hello"
        };
        sendFunny(funny);
        test();
    }
}

dict FunnierFunnyNess {
   val funnyNess: FunnyNess
}

@OnPlayerSelection
fn test() {
   val funnier = FunnierFunnyNess {
      funnyNess: FunnyNess {
         level: 5,
         message: "Hello World"
      }
   };

   sendFunny(funnier.funnyNess);
}

fn get5(): Number {
    return 5;
}
